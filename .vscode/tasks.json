{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "type": "go",
      "label": "go: build package",
      "command": "build",
      "args": [
        "${workspaceFolder}"
      ],
      "problemMatcher": [
        "$go"
      ],
      "group": "build"
    },
    {
      "label": "start service",
      "type": "shell",
      "command": "systemctl restart appinnCBot",
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "dependsOn": [
        "go: build package"
      ],
      "problemMatcher": [
        "$go"
      ]
    },
  ]
}